import io, subprocess
import numpy as np
from PIL import Image
V='media/pt-br-historia/vietna/render/S03.mp4'
def frame(ts, sc=None):
    cmd=['ffmpeg','-y','-ss',str(ts),'-i',V,'-frames:v','1']
    if sc: cmd+=['-vf','scale=%d:%d'%sc]
    cmd+=['-f','image2pipe','-vcodec','png','-']
    return np.asarray(Image.open(io.BytesIO(subprocess.run(cmd,capture_output=True,check=True).stdout)).convert('RGB')).astype(float)
def zam(a,b,ox,oy,z0,z1,tt):
    z=z0+(z1-z0)*(tt*tt*(3-2*tt))
    return z,ox+(a-ox)*z,oy+(b-oy)*z
def leftedge(a):
    roi=a[20:230,280:600]
    R,G,B=roi[:,:,0],roi[:,:,1],roi[:,:,2]
    m=((G>R*1.18)&(G>B*1.25)&(G>70))|((R>130)&(G>110)&(B<R*0.65)&(B<G*0.75))
    col=m.sum(axis=0); nz=np.where(col>3)[0]
    return int(nz[0]+280)
print('--- borda do mastro (x de tela -> x de cena) ---')
for ts in [7.3,7.6,8.0,8.5,9.0,9.5]:
    a=frame(ts); z,xs,_=zam(322,0,576,0,1.03,1.08,(ts-7.2)/2.71)
    le=leftedge(a); x0=576+(le-576)/z
    print(f'  {ts}: x_tela={le}  x_cena={x0:.1f}')
print('--- emendas 640x360 @8.5 ---')
b=frame(8.5,(640,360)); roi=b[20:68,105:186]
d=np.abs(np.diff(roi,axis=1)).mean(axis=(0,2))
top=sorted([(round(float(v),1),int(i+105)) for i,v in enumerate(d)],reverse=True)[:8]
print('  picos',top)
print('--- deformacao ativa: residual no interior da bandeira ---')
f1=frame(8.0); f2=frame(8.5)
z1,_,_=zam(0,0,0,0,1.03,1.08,(8.0-7.2)/2.71); z2,_,_=zam(0,0,0,0,1.03,1.08,(8.5-7.2)/2.71)
ys,xs=np.mgrid[70:205,340:520]
sx1=576+(xs-576)*z1; sy1=432+(ys-432)*z1
sx2=576+(xs-576)*z2; sy2=432+(ys-432)*z2
p1=f1[np.clip(np.rint(sy1).astype(int),0,1079),np.clip(np.rint(sx1).astype(int),0,1919)]
p2=f2[np.clip(np.rint(sy2).astype(int),0,1079),np.clip(np.rint(sx2).astype(int),0,1919)]
print('  residual medio bandeira',round(float(np.abs(p1-p2).mean()),2))
bg1=f1[70:205,700:880]; bg2=f2[70:205,700:880]
print('  residual medio fundo   ',round(float(np.abs(bg1-bg2).mean()),2))
print('--- CH-53 @6.2 (recorte sobre fundo de 4.3) ---')
h=frame(6.2); bgf=frame(4.35)
reg=(slice(120,330),slice(560,980))
dif=np.abs(h[reg]-bgf[reg]).mean(axis=2)
mask=dif>28
px=h[reg][mask]
print('  pixels ator',len(px))
mx=px.mean(axis=0)
print('  RGB medio',np.round(mx,1),'sat max-min',round(float(mx.max()-mx.min()),1))
"

