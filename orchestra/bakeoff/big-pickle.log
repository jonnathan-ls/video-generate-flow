import io, subprocess
import numpy as np
from PIL import Image
V='media/pt-br-historia/vietna/render/S03.mp4'
def frame(ts, sc=None):
    cmd=['ffmpeg','-y','-ss',str(ts),'-i',V,'-frames:v','1']
    if sc: cmd+=['-vf','scale=%d:%d'%sc]
    cmd+=['-f','image2pipe','-vcodec','png','-']
    return np.asarray(Image.open(io.BytesIO(subprocess.run(cmd,capture_output=True,check=True).stdout)).convert('RGB'))
def edge(a):
    roi=a[20:230,280:600].astype(int)
    R,G,B=roi[:,:,0],roi[:,:,1],roi[:,:,2]
    m=((G>R*1.18)&(G>B*1.25)&(G>70))|((R>130)&(G>110)&(B<R*0.65)&(B<G*0.75))
    col=m.sum(axis=0); nz=np.where(col>3)[0]
    return int(nz[0]+280),int(nz[-1]+280)
for ts in [7.3,7.6,8.0,8.5,9.0,9.5,9.8]:
    print(ts, edge(frame(ts)))
print('--- seams full res at 8.5 ---')
a=frame(8.5).astype(float)[34:215,308:569]
d=np.abs(np.diff(a,axis=1)).mean(axis=(0,2))
print('mean',round(d.mean(),2),'p50',round(np.percentile(d,50),2),'p95',round(np.percentile(d,95),2),'max',round(d.max(),2),'argmax',int(d.argmax())+308)
print('top10', sorted([(round(float(v),2),int(i+308)) for i,v in enumerate(d)],reverse=True)[:10])
print('--- seams 640x360 at 8.5 ---')
b=frame(8.5,(640,360)).astype(float)[11:72,102:190]
d2=np.abs(np.diff(b,axis=1)).mean(axis=(0,2))
print('mean',round(d2.mean(),2),'p50',round(np.percentile(d2,50),2),'p95',round(np.percentile(d2,95),2),'max',round(d2.max(),2),'argmax',int(d2.argmax())+102)
print('top10', sorted([(round(float(v),2),int(i+102)) for i,v in enumerate(d2)],reverse=True)[:10])
"

