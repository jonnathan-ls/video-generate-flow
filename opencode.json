{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "*.env*": "deny",
      "*.env": "deny",
      "*/.env*": "deny",
      "*~/scripts*": "deny",
      "*kit-flow-generate*": "deny"
    },
    "webfetch": "allow",
    "external_directory": {
      "*": "deny",
      "/home/jonnathan/.claude/skills/claude-video/**": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env": "deny"
    }
  },
  "watcher": {
    "ignore": [
      "media/**",
      "studio/remotion/node_modules/**",
      ".venv/**"
    ]
  },
  "mcp": {
    "flow": {
      "type": "local",
      "command": [
        "node",
        "/home/jonnathan/flow-mcp/dist/index.js"
      ],
      "enabled": true
    }
  },
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash (pago)"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (pago)"
        }
      }
    }
  }
}